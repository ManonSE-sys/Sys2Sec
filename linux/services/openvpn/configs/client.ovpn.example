client
dev tun
proto udp

remote ADRESSE_DU_SERVEUR 1194

resolv-retry infinite
nobind

persist-key
persist-tun

remote-cert-tls server

verb 3

# Selon les versions OpenVPN déployées, adapter les paramètres
# cryptographiques au serveur.

<ca>
-----BEGIN CERTIFICATE-----
COPIER_LE_CERTIFICAT_CA_ICI
-----END CERTIFICATE-----
</ca>

<cert>
-----BEGIN CERTIFICATE-----
COPIER_LE_CERTIFICAT_CLIENT_ICI
-----END CERTIFICATE-----
</cert>

<key>
-----BEGIN PRIVATE KEY-----
COPIER_LA_CLE_PRIVEE_CLIENT_ICI
-----END PRIVATE KEY-----
</key>
