label Desktop
         menu label Installation Desktop
         kernel ../DOSSIER_VERSION/server/vmlinuz
         initrd ../DOSSIER_VERSION/server/initrd
         append root=/dev/ram0 ramdisk_size=150000 vga=normal  cloud-config-url=/dev/null ip=dhcp url=http://192.168.1.145/iso/IMAGE_ISO autoinstall ds=nocloud-net;s=http://192.168.1.145/DOSSIER_VERSION/desktop/

label Server
         menu label Installation Serveur                                      
         kernel ../DOSSIER_VERSION/server/vmlinuz
         initrd ../DOSSIER_VERSION/server/initrd
         append root=/dev/ram0 ramdisk_size=150000 vga=normal  cloud-config-url=/dev/null ip=dhcp url=http://192.168.1.145/iso/IMAGE_ISO autoinstall ds=nocloud-net;s=http://192.168.1.145/DOSSIER_VERSION/server/
